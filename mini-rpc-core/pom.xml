<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 继承父工程中的 Java 版本和依赖版本管理。 -->
    <parent>
        <groupId>com.itheima</groupId>
        <artifactId>mini-rpc-parent</artifactId>
        <version>1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>mini-rpc-core</artifactId>
    <name>mini-rpc-core</name>

    <dependencies>
        <!-- RpcRequest 和 RpcResponse 使用 Lombok 生成重复代码。 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- 为后续 JsonSerializer 保留；版本由父工程统一管理。 -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- 框架只面向日志接口编程，不绑定某一个日志实现。 -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!--
            M2 使用 Netty 实现新的客户端和服务端传输层。
            这里只声明“core 模块需要 Netty”，具体版本由父工程统一管理。
        -->
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-all</artifactId>
        </dependency>

        <!--
            M4 使用 Curator 连接和操作外部 ZooKeeper 服务。
            当前先引入基础 Framework；需要节点缓存、监听等高级能力时再加入 recipes。
        -->
        <dependency>
            <groupId>org.apache.curator</groupId>
            <artifactId>curator-framework</artifactId>
        </dependency>
    </dependencies>
</project>
