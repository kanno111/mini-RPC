<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 继承父工程中的 Java 版本和依赖版本管理。 -->
    <parent>
        <groupId>io.github.kaano</groupId>
        <artifactId>mini-rpc-parent</artifactId>
        <version>1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>mini-rpc-core</artifactId>
    <name>mini-rpc-core</name>

    <dependencies>
        <!-- RpcRequest 和 RpcResponse 使用 Lombok 生成重复代码。 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- 为后续 JsonSerializer 保留；版本由父工程统一管理。 -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- 框架只面向日志接口编程，不绑定某一个日志实现。 -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!--
            R3-A 使用 Micrometer 的统一指标 API 记录 RPC 请求数量和耗时。
            core 只依赖 micrometer-core，不依赖 Actuator、Prometheus 或具体监控后端；
            版本继续由父工程导入的 Spring Boot BOM 统一管理。
        -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
        </dependency>

        <!--
            M2 使用 Netty 实现新的客户端和服务端传输层。
            这里只声明“core 模块需要 Netty”，具体版本由父工程统一管理。
        -->
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-all</artifactId>
        </dependency>

        <!--
            M4 使用 Curator 连接和操作外部 ZooKeeper 服务。
            当前先引入基础 Framework；需要节点缓存、监听等高级能力时再加入 recipes。
        -->
        <dependency>
            <groupId>org.apache.curator</groupId>
            <artifactId>curator-framework</artifactId>
        </dependency>

        <!--
            Java 反射可以读取一个已知类的注解，但不能直接列出包中的所有类。
            ClassGraph 负责扫描指定包，找出所有带有 @RpcService 的实现类。
        -->
        <dependency>
            <groupId>io.github.classgraph</groupId>
            <artifactId>classgraph</artifactId>
        </dependency>

        <!-- core 首次加入独立单元测试；测试依赖不会进入业务应用的运行包。 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            S5-D 只在测试期间通过 Docker 启动真实 ZooKeeper；这些依赖不会进入
            mini-rpc-core 的生产运行包，也不会要求业务项目引入 Testcontainers。
        -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
