<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.itheima</groupId>
    <artifactId>mini-rpc-parent</artifactId>
    <version>1.0-SNAPSHOT</version>

    <!--
        pom 表示根项目只是“父工程/聚合工程”，自己不再编译 Java 源码。
        真正的源码分别放在下面四个子模块中。
    -->
    <packaging>pom</packaging>

    <!-- 在根目录执行 Maven 命令时，这四个模块会一起参与构建。 -->
    <modules>
        <module>mini-rpc-core</module>
        <module>mini-rpc-example-api</module>
        <module>mini-rpc-example-provider</module>
        <module>mini-rpc-example-consumer</module>
    </modules>

    <!-- 所有子模块都会继承这些基础配置和版本号。 -->
    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <maven.compiler.proc>full</maven.compiler.proc>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <lombok.version>1.18.48</lombok.version>
        <jackson.version>2.22.3</jackson.version>
        <slf4j.version>2.0.20</slf4j.version>
        <logback.version>1.6.5</logback.version>
        <!-- Netty 是 M2 使用的网络通信框架，由父工程统一管理版本。 -->
        <netty.version>4.2.19.Final</netty.version>
        <!-- Curator 是 M4 操作 ZooKeeper 的 Java 客户端框架。 -->
        <curator.version>5.9.0</curator.version>
    </properties>

    <!--
        dependencyManagement 只统一管理版本，并不会自动把依赖加入子模块。
        每个子模块仍然需要明确声明自己真正使用的依赖。
    -->
    <dependencyManagement>
        <dependencies>
            <!-- 项目内部模块。 -->
            <dependency>
                <groupId>com.itheima</groupId>
                <artifactId>mini-rpc-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.itheima</groupId>
                <artifactId>mini-rpc-example-api</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- 第三方依赖。 -->
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>${jackson.version}</version>
            </dependency>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${slf4j.version}</version>
            </dependency>
            <dependency>
                <groupId>ch.qos.logback</groupId>
                <artifactId>logback-classic</artifactId>
                <version>${logback.version}</version>
            </dependency>
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-all</artifactId>
                <version>${netty.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.curator</groupId>
                <artifactId>curator-framework</artifactId>
                <version>${curator.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
