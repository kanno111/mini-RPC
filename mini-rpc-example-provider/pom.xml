<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.kaano</groupId>
        <artifactId>mini-rpc-parent</artifactId>
        <version>1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>mini-rpc-example-provider</artifactId>
    <name>mini-rpc-example-provider</name>

    <dependencies>
        <!-- 服务端需要使用 RPC 框架启动 Socket 服务并处理请求。 -->
        <dependency>
            <groupId>io.github.kaano</groupId>
            <artifactId>mini-rpc-spring-boot-starter</artifactId>
        </dependency>

        <!-- 服务端实现 API 模块定义的 HelloService 接口。 -->
        <dependency>
            <groupId>io.github.kaano</groupId>
            <artifactId>mini-rpc-example-api</artifactId>
        </dependency>

        <!-- 可运行模块提供具体日志实现，框架核心仍只依赖 SLF4J API。 -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>
</project>
